# Copy this file to `.env.local` and fill in the two values from your Supabase
# project: Dashboard -> Project Settings -> API.
#
# Without these the app still works — it just keeps everything on one phone
# instead of sharing between people.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
